{
  "name": "ink-scrollable-box",
  "version": "1.1.4",
  "description": "Scrollable container component for Ink with keyboard navigation, vim bindings, and auto-follow",
  "keywords": [
    "ink",
    "react",
    "cli",
    "terminal",
    "scroll",
    "scrollable",
    "scrollbar",
    "viewport",
    "tui",
    "vim",
    "keyboard"
  ],
  "author": "John Costa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/costajohnt/ink-scrollable-box"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "ink": ">=6.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@costajohnt/ink-config": "github:costajohnt/ink-config",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.2",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "xo": "^5.0.1"
  }
}
